entorno=desarrollo
llave_secreta=tu_llave_secreta_super_larga_y_segura_de_mas_de_32_caracteres
Algoritmo=HS256
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
token_expiracion=30
#En desarrollo va debug true, pero en produccion e coloca false, para que hackers no vean los errores internos de python.
DEBUG=true
MANTENIMIENTO=false

# ==========================================
# CONFIGURACIÓN DE CORREO (SMTP)
# ==========================================
# Ejemplo para Gmail: smtp.gmail.com
EMAIL_EN_CONSOLA=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587#El 587 es el número de puerto de red estándar que se utiliza para enviar correos electrónicos de forma segura usando el protocolo SMTP con STARTTLS.
SMTP_USER=gymrodrepotesal@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_de_google
#Básicamente, es para que nadie pueda robar tus contraseñas o datos mientras viajan por internet hacia el correo.
SMTP_SSL=false # en puerto 587 siempre tiene que ir false, La conexión se cifra de forma obligatoria y estricta desde el mismísimo microsegundo en que se abre la puerta (suele usar el puerto 465).


# MODO PRUEBA: En desarrollo ponlo en true para que el sistema 
# no envíe correos reales, sino que imprima el código en la consola.

# Nombre que aparecerá en las notificaciones del sistema
NOMBRE_APP=Sistema de Inventario 


# ==========================================
# CONFIGURACIÓN DE CÓDIGOS DE VERIFICACIÓN
# ==========================================
CODIGO_EXPIRA_MINUTOS=15
CODIGO_MAX_INTENTOS=5
CODIGO_REENVIO_SEGUNDOS=60


# ==========================================
# SEGURIDAD Y BLOQUEO DE CUENTAS (LOGIN)
# ==========================================
# Número máximo de contraseñas incorrectas antes de bloquear la cuenta
LOGIN_MAX_INTENTOS=5
# Minutos que la cuenta permanecerá bloqueada por seguridad
LOGIN_BLOQUEO_MINUTOS=15